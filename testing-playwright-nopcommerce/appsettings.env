# NopCommerce Playwright C# Tests - Cấu hình môi trường

# URL ứng dụng nopCommerce
BASE_URL=https://localhost:59579/

# Tài khoản Admin
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=123456

# Tài khoản Customer active (đang hoạt động)
CUSTOMER_EMAIL=buihoang3425@gmail.com
CUSTOMER_PASSWORD=123456

# Tài khoản Customer Inactive (bị vô hiệu hóa)
INACTIVE_EMAIL=inactive@gmail.com
